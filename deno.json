{
	"imports": {
		"addons-linter": "npm:addons-linter@^10.4.0",
		"jquery": "npm:jquery@4",
		"bootstrap": "npm:bootstrap@^5.3.8",
		"vue": "npm:vue@^3.5.33",
		"web-ext": "npm:web-ext@^10.1.0"
	},
	"nodeModulesDir": "auto",
	"compilerOptions": {
		"types": [
			"npm:@types/jquery",
			"npm:@types/bootstrap"
		]
	},
	"tasks": {
		"vendor.js": "deno bundle --platform browser --output web/vendor.js js/vendor.js",
		"vendor.css": "deno bundle --platform browser --output web/vendor.css css/vendor.css",
		"widgets": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys --allow-run --allow-ffi widgets/build.js",
		"build": "deno task vendor.js && deno task vendor.css && deno task widgets",
		"web-ext": "deno --allow-env --allow-sys --allow-read --allow-write web-ext",
		"web-ext-help": "deno task web-ext --help",
		"web-ext-lint": "deno task web-ext lint --self-hosted --ignore-files web examples",
		"firefox-web-ext": "deno run --allow-read --allow-write firefox-web-ext.js"
	},
	"allowScripts": {
		"allow": [
			"npm:spawn-sync@1.0.15"
		]
	}
}